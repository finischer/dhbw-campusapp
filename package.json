{
  "name": "dhbw-campusapp",
  "version": "1.4.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preinstall": "npm i npm-license-crawler -g",
    "postinstall": "npm-license-crawler -onlyDirectDependencies -json licenses.json",
    "simulator-build:android": "eas build --profile development-simulator --platform android",
    "preview-build:android": "eas build --profile preview --platform android",
    "production-build:android": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --latest",
    "simulator-build:ios": "eas build --profile development-simulator --platform ios",
    "preview-build:ios": "eas build --profile preview --platform ios",
    "production-build:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios --latest",
    "update:android": "eas update --platform android",
    "update:ios": "eas update --platform ios",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/source-sans-pro": "^0.2.2",
    "@expo/vector-icons": "^14.0.0",
    "@os-team/i18next-react-native-language-detector": "^1.0.21",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-segmented-control/segmented-control": "2.5.4",
    "@react-navigation/material-bottom-tabs": "^6.2.7",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.7",
    "@types/react": "~18.3.12",
    "axios": "^1.2.0",
    "cheerio-without-node-native": "^0.20.2",
    "expo": "^52.0.46",
    "expo-background-fetch": "~13.0.6",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-image": "~2.0.7",
    "expo-insights": "~0.8.2",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-store-review": "~8.0.1",
    "expo-task-manager": "~12.0.6",
    "expo-updates": "~0.27.4",
    "expo-web-browser": "~14.0.2",
    "i18next": "^22.0.6",
    "ical.js": "^1.5.0",
    "moment": "^2.29.4",
    "qs": "^6.11.0",
    "react": "18.3.1",
    "react-i18next": "^12.0.0",
    "react-native": "^0.76.9",
    "react-native-bouncy-checkbox": "^3.0.6",
    "react-native-dialog": "^9.3.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-uuid": "^2.0.1",
    "react-native-vector-icons": "^9.2.0",
    "react-query": "^3.39.2",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/qs": "^6.9.7",
    "@types/react-query": "^1.2.9",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1"
  },
  "private": true
}
